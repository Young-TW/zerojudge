/build
*.exe
/.vscode
*.o
/.cache
__pycache__/
# 對拍：模型生成的暴力解與反例不進版控
problems/*/brute.*
problems/*/counter.*
# 視覺轉述(模型讀圖產物,非答案),不進 git
problems/*/img_desc.txt
# Agent 記憶鏡像（含環境/帳號資訊，絕不進 git）
/.agent-memory/
# 提交產線腳本(Safari 自動化,含帳號機制,絕不進 git)
/submit/
# 提交判定 runtime log(reconcile/orchestrator 追寫,非版控內容)
/src/safari_submit.log
# 產線運維工具+記憶(敏感:含帳號/VM/端點,絕不進 git,自行同步)
/ops/
# sample-ac 是未驗證本地解工作池(大多非真AC),不進版控;真AC 由 promote 進 src/ac
/src/sample-ac/
# 樣本汙染修復的原始備份(本機復原用,非答案)
problems/*/orig_samples/
problems/*/*.orig
